@model IReadOnlyList<LeadManagementPortal.Models.ImportProfile>

@{
    ViewData["Title"] = "Import Profiles";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-1">Import Profiles</h2>
        <p class="text-muted mb-0">Saved column mappings for messy spreadsheet sources.</p>
    </div>
    <a asp-action="CreateProfile" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i>New Profile
    </a>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Source</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var profile in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@profile.Name</td>
                                <td>@(profile.SourceSystem ?? "-")</td>
                                <td>
                                    <span class="badge @(profile.IsActive ? "bg-success" : "bg-secondary")">
                                        @(profile.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td class="text-end">
                                    <a asp-action="EditProfile" asp-route-id="@profile.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">No import profiles exist yet.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
