@model IReadOnlyList<LeadManagementPortal.Models.CommissionAdjustment>

@{
    ViewData["Title"] = "Commission Adjustments";
}

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">Create Adjustment</div>
            <div class="card-body">
                <form asp-action="CreateAdjustment" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label">Beneficiary</label>
                        <select name="BeneficiaryId" class="form-select" asp-items="ViewBag.Beneficiaries"></select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Amount</label>
                        <input name="Amount" type="number" class="form-control" step="0.01" />
                        <div class="form-text">Use negative values for clawbacks/corrections.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Reason</label>
                        <input name="Reason" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Notes</label>
                        <textarea name="Notes" rows="3" class="form-control"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary">Create Adjustment</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">Recent Adjustments</div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Beneficiary</th>
                                <th>Reason</th>
                                <th>Notes</th>
                                <th class="text-end">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Any())
                            {
                                @foreach (var adjustment in Model)
                                {
                                    <tr>
                                        <td>@adjustment.CreatedAtUtc.ToString("yyyy-MM-dd")</td>
                                        <td>@(adjustment.Beneficiary?.FullName ?? adjustment.Beneficiary?.Email ?? adjustment.BeneficiaryId)</td>
                                        <td>@adjustment.Reason</td>
                                        <td>@adjustment.Notes</td>
                                        <td class="text-end @(adjustment.Amount >= 0 ? "text-success" : "text-danger")">@adjustment.Amount.ToString("C")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">No adjustments recorded yet.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
