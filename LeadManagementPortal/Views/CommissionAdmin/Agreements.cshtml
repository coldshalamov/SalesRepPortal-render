@model IReadOnlyList<LeadManagementPortal.Models.CommissionAgreement>

@{
    ViewData["Title"] = "Commission Agreements";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-1">Commission Agreements</h2>
        <p class="text-muted mb-0">Boss-defined rules that decide who gets paid from each business account.</p>
    </div>
    <div class="btn-group">
        <a asp-action="AccountPricing" class="btn btn-outline-secondary">
            <i class="bi bi-currency-dollar me-1"></i>Account Pricing
        </a>
        <a asp-action="CreateAgreement" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>New Agreement
        </a>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Agreement</th>
                        <th>Account</th>
                        <th>Dates</th>
                        <th>Recipients</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var agreement in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@agreement.Name</div>
                                    <div class="text-muted small">@agreement.ProductNameFilter</div>
                                </td>
                                <td>@agreement.BusinessAccount?.Name</td>
                                <td>@agreement.EffectiveStartDate.ToString("yyyy-MM-dd") to @agreement.EffectiveEndDate.ToString("yyyy-MM-dd")</td>
                                <td>@agreement.Recipients.Count</td>
                                <td>
                                    <span class="badge @(agreement.IsActive ? "bg-success" : "bg-secondary")">
                                        @(agreement.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td class="text-end">
                                    <a asp-action="EditAgreement" asp-route-id="@agreement.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                    <a asp-action="FlowAgreement" asp-route-id="@agreement.Id" class="btn btn-sm btn-outline-secondary">Flow</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">No agreements exist yet.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
