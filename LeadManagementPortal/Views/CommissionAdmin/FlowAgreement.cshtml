@model LeadManagementPortal.Models.ViewModels.CommissionAgreementFlowViewModel

@{
    ViewData["Title"] = "Commission Flow";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-1">Bottom-Up Commission Flow</h2>
        <p class="text-muted mb-0">@Model.BusinessAccountName - @Model.AgreementName</p>
    </div>
    <a asp-action="Agreements" class="btn btn-outline-secondary">Back to Agreements</a>
</div>

<div class="card mb-4">
    <div class="card-header">Simulation Inputs</div>
    <div class="card-body">
        <form method="get" asp-action="FlowAgreement" class="row g-3">
            <input type="hidden" name="id" value="@Model.AgreementId" />
            <div class="col-md-3">
                <label class="form-label">Gross Amount</label>
                <input type="number" step="0.01" min="0" name="grossAmount" value="@Model.SampleGrossAmount" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Cost Amount</label>
                <input type="number" step="0.01" min="0" name="costAmount" value="@Model.SampleCostAmount" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Quantity</label>
                <input type="number" step="1" min="1" name="quantity" value="@Model.SampleQuantity" class="form-control" />
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button type="submit" class="btn btn-primary">Recalculate Flow</button>
            </div>
        </form>
        <div class="mt-3 text-muted small">
            Product filter: @(string.IsNullOrWhiteSpace(Model.ProductNameFilter) ? "Any product" : Model.ProductNameFilter)
            | Effective: @Model.EffectiveStartDate.ToString("yyyy-MM-dd") to @Model.EffectiveEndDate.ToString("yyyy-MM-dd")
            | Net: @Model.SampleNetAmount.ToString("C")
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">Flow Graph (Sale Starts At Bottom, Commissions Flow Upward)</div>
    <div class="card-body">
        <pre class="mermaid">
@Model.MermaidGraph
        </pre>
    </div>
</div>

<div class="card">
    <div class="card-header">Recipient Breakdown</div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Step</th>
                        <th>Beneficiary</th>
                        <th>Calculation</th>
                        <th>Basis</th>
                        <th class="text-end">Commission</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Recipients)
                    {
                        <tr>
                            <td>@row.SortOrder</td>
                            <td>@row.BeneficiaryName</td>
                            <td>@row.CalculationType at @row.RateOrAmount</td>
                            <td>@(row.BasisSortOrder.HasValue ? $"Step {row.BasisSortOrder.Value}" : "Sale Event")</td>
                            <td class="text-end fw-semibold">@row.CommissionAmount.ToString("C")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script type="module">
        import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';
        mermaid.initialize({ startOnLoad: true, theme: 'default' });
    </script>
}
