@model IReadOnlyList<LeadManagementPortal.Models.ViewModels.CommissionLedgerRowViewModel>

@{
    ViewData["Title"] = "Commission Records";
    ViewBag.Breadcrumbs = new[] {
        new { Label = "Commissions", Url = "/Commissions" },
        new { Label = "All Records", Url = "" }
    };
    var legacyCount = Model.Count(r => r.IsLegacy);
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 pt-3 pb-2 mb-4 border-bottom">
    <div>
        <h1 class="h2 mb-1">All Commission Records</h1>
        <p class="text-muted mb-0 small">
            @Model.Count total row@(Model.Count == 1 ? "" : "s")
            @if (legacyCount > 0)
            {
                <span>&middot; @legacyCount legacy (historical)</span>
            }
        </p>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Back to Summary
        </a>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="small">Date</th>
                        <th class="small">Account</th>
                        <th class="small">Product</th>
                        <th class="small">Source</th>
                        <th class="small">Recipient</th>
                        <th class="small">Type</th>
                        <th class="small">Basis</th>
                        <th class="text-end small">Gross</th>
                        <th class="text-end small">Net</th>
                        <th class="text-end small">Paid</th>
                        <th class="text-end small">Outstanding</th>
                        <th class="text-end small">Commission</th>
                        <th class="small">Notes</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var row in Model)
                        {
                            <tr class="@(row.IsLegacy ? "text-muted" : "")">
                                <td class="small">@row.SaleDate.ToString("MMM d, yyyy")</td>
                                <td class="small">@row.BusinessAccountName</td>
                                <td class="small">
                                    @row.ProductName
                                    @if (row.IsLegacy)
                                    {
                                        <span class="badge bg-secondary ms-1" style="font-size:.6rem;vertical-align:middle">Legacy</span>
                                    }
                                </td>
                                <td class="small">@row.SourceSystem</td>
                                <td class="small">@row.BeneficiaryName</td>
                                <td class="small">@row.DealType</td>
                                <td class="small">@row.CalculationBasis</td>
                                <td class="text-end small">@row.GrossAmount.ToString("C")</td>
                                <td class="text-end small">@row.NetAmount.ToString("C")</td>
                                <td class="text-end small">@row.PaidAmount.ToString("C")</td>
                                <td class="text-end small">@row.OutstandingAmount.ToString("C")</td>
                                <td class="text-end fw-semibold small @(row.IsLegacy ? "" : "text-success")">@row.CommissionAmount.ToString("C")</td>
                                <td class="small text-muted">@row.CalculationNotes</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="13" class="text-center text-muted py-5 small">No ledger rows are visible for this user.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
