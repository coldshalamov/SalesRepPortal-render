@model IReadOnlyList<LeadManagementPortal.Models.ViewModels.CommissionLedgerRowViewModel>

@{
    ViewData["Title"] = "Commission Ledger Details";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">Commission Ledger Details</h1>
    <div class="btn-toolbar">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Summary
        </a>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Product</th>
                        <th>Beneficiary</th>
                        <th>Depth</th>
                        <th>Deal Type</th>
                        <th>Basis</th>
                        <th class="text-end">Gross</th>
                        <th class="text-end">Net</th>
                        <th class="text-end">Commission</th>
                        <th>Notes</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var row in Model)
                        {
                            <tr>
                                <td>@row.SaleDate.ToString("MMM dd, yyyy")</td>
                                <td>@row.ProductName</td>
                                <td>@row.BeneficiaryName</td>
                                <td>@row.ChainDepth</td>
                                <td>@row.DealType</td>
                                <td>@row.CalculationBasis</td>
                                <td class="text-end">@row.GrossAmount.ToString("C")</td>
                                <td class="text-end">@row.NetAmount.ToString("C")</td>
                                <td class="text-end fw-semibold text-success">@row.CommissionAmount.ToString("C")</td>
                                <td>@row.CalculationNotes</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="text-center text-muted py-4">No ledger rows are visible for this user.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
