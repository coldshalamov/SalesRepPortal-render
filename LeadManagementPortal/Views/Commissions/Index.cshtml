@model LeadManagementPortal.Models.ViewModels.CommissionDashboardViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Commissions";
    ViewBag.Breadcrumbs = new[] { new { Label = "Commissions", Url = "" } };
}

<style>
.comm-stat { background: #fff; border: 1px solid #dee2e6; border-top: 3px solid #0d6efd; border-radius: .5rem; padding: 1.25rem 1.5rem; }
.comm-stat-green  { border-top-color: #198754; }
.comm-stat-orange { border-top-color: #fd7e14; }
.comm-stat-gray   { border-top-color: #6c757d; }
.comm-stat-label { font-size: .7rem; text-transform: uppercase; letter-spacing: .06em; color: #6c757d; margin-bottom: .25rem; }
.comm-stat-value { font-size: 1.65rem; font-weight: 700; color: #212529; line-height: 1.2; }
.comm-stat-sub { font-size: .72rem; color: #adb5bd; margin-top: .25rem; }
</style>

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 pt-3 pb-2 mb-4 border-bottom">
    <div>
        <h1 class="h2 mb-1">Commissions</h1>
        @if (Model.IsAdminView)
        {
            <p class="text-muted mb-0 small">
                @Model.TotalLedgerRows row@(Model.TotalLedgerRows == 1 ? "" : "s")
                &middot; @Model.BusinessAccountCount account@(Model.BusinessAccountCount == 1 ? "" : "s")
                &middot; @Model.ActiveAgreementCount active agreement@(Model.ActiveAgreementCount == 1 ? "" : "s")
            </p>
        }
        else
        {
            <p class="text-muted mb-0 small">Your commission statement</p>
        }
    </div>
    <div class="d-flex gap-2 flex-wrap">
        @if (Model.IsAdminView)
        {
            <a asp-controller="CommissionAdmin" asp-action="Imports" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-sliders me-1"></i>Control Plane
            </a>
        }
        @if (User.IsInRole("OrganizationAdmin") || User.IsInRole("GroupAdmin") || User.IsInRole("SalesOrgAdmin"))
        {
            <a asp-action="Hierarchy" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-diagram-2 me-1"></i>Account Map
            </a>
        }
        <a asp-action="Details" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-table me-1"></i>All Records
        </a>
    </div>
</div>

@if (Model.LegacyRowCount > 0)
{
    <div class="alert alert-secondary d-flex align-items-start gap-2 py-2 px-3 mb-4 small border-start border-4 border-secondary rounded-start-0" role="alert">
        <i class="bi bi-archive mt-1 flex-shrink-0"></i>
        <span>
            <strong>@Model.LegacyRowCount</strong> historical record@(Model.LegacyRowCount == 1 ? "" : "s") (@Model.LegacyTotalAmount.ToString("C"))
            from the legacy system are excluded from these totals and cannot be tracked for payouts.
            <a asp-action="Details" class="alert-link">View all records</a>
        </span>
    </div>
}

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card mui-kpi-card mui-magic-card mui-beam-card mb-3">
            <div class="card-header">Total Earned</div>
            <div class="card-body">
                <div class="mui-kpi-value mb-1">
                    <span class="mui-number-ticker"
                          data-format="currency"
                          data-decimals="2"
                          data-value="@Model.TotalCommissionEarned.ToString(CultureInfo.InvariantCulture)"></span>
                </div>
                <p class="mui-kpi-subtext mb-0">
                    <span class="mui-number-ticker" data-value="@Model.TotalLedgerRows"></span> ledger rows
                </p>
            </div>
            <span class="mui-border-beam" style="--beam-duration: 7.5s;"></span>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card mui-kpi-card mui-magic-card mui-beam-card mb-3">
            <div class="card-header">This Month</div>
            <div class="card-body">
                <div class="mui-kpi-value mb-1">
                    <span class="mui-number-ticker"
                          data-format="currency"
                          data-decimals="2"
                          data-value="@Model.CurrentMonthCommission.ToString(CultureInfo.InvariantCulture)"></span>
                </div>
                <p class="mui-kpi-subtext mb-0">Current-month earned commissions.</p>
            </div>
            <span class="mui-border-beam" style="--beam-duration: 9.5s;"></span>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card mui-kpi-card mui-magic-card mui-beam-card mb-3">
            <div class="card-header">Outstanding</div>
            <div class="card-body">
                <div class="mui-kpi-value mb-1">
                    <span class="mui-number-ticker"
                          data-format="currency"
                          data-decimals="2"
                          data-value="@Model.OutstandingBalance.ToString(CultureInfo.InvariantCulture)"></span>
                </div>
                <p class="mui-kpi-subtext mb-0">Earned plus adjustments minus payouts.</p>
            </div>
            <span class="mui-border-beam" style="--beam-duration: 11s;"></span>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card mui-kpi-card mui-magic-card mui-beam-card mb-3">
            <div class="card-header">Adjustments</div>
            <div class="card-body">
                <div class="mui-kpi-value mb-1">
                    <span class="mui-number-ticker"
                          data-format="currency"
                          data-decimals="2"
                          data-value="@Model.TotalAdjustments.ToString(CultureInfo.InvariantCulture)"></span>
                </div>
                <p class="mui-kpi-subtext mb-0">Net manual corrections applied.</p>
            </div>
            <span class="mui-border-beam" style="--beam-duration: 8.2s;"></span>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card mui-kpi-card mui-magic-card mui-beam-card mb-3">
            <div class="card-header">Paid</div>
            <div class="card-body">
                <div class="mui-kpi-value mb-1">
                    <span class="mui-number-ticker"
                          data-format="currency"
                          data-decimals="2"
                          data-value="@Model.TotalPaid.ToString(CultureInfo.InvariantCulture)"></span>
                </div>
                <p class="mui-kpi-subtext mb-0">Amount already included in payout batches.</p>
            </div>
            <span class="mui-border-beam" style="--beam-duration: 10.2s;"></span>
        </div>
    </div>
    @if (Model.IsAdminView)
    {
        <div class="col-md-4">
            <div class="card mui-kpi-card mui-magic-card mui-beam-card mb-3">
                <div class="card-header">Review Queue</div>
                <div class="card-body">
                    <div class="mui-kpi-value mb-1">
                        <span class="mui-number-ticker" data-value="@Model.PendingReviewRows"></span>
                        <span class="fs-6 text-secondary">pending</span>
                        <span class="fs-6 text-secondary">/</span>
                        <span class="mui-number-ticker" data-value="@Model.ReadyToPostRows"></span>
                        <span class="fs-6 text-secondary">ready</span>
                    </div>
                    <p class="mui-kpi-subtext mb-0">
                        <span class="mui-number-ticker" data-value="@Model.BusinessAccountCount"></span> accounts,
                        <span class="mui-number-ticker" data-value="@Model.ActiveAgreementCount"></span> active agreements.
                    </p>
                </div>
                <span class="mui-border-beam" style="--beam-duration: 7.8s;"></span>
            </div>
        </div>
    }
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header bg-transparent fw-semibold border-bottom py-3">
                Earnings by Type
            </div>
            <div class="card-body p-0">
                @if (Model.BreakdownByDealType.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Type</th>
                                    <th class="text-end">Rows</th>
                                    <th class="text-end">Earned</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in Model.BreakdownByDealType)
                                {
                                    <tr>
                                        <td class="small">@row.DealType</td>
                                        <td class="text-end small">@row.RowCount</td>
                                        <td class="text-end fw-semibold small">@row.TotalCommission.ToString("C")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-5 small">No commission data yet.</div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card h-100">
            <div class="card-header bg-transparent d-flex justify-content-between align-items-center py-3">
                <span class="fw-semibold">@(Model.IsAdminView ? "Recent Ledger Rows" : "My Recent Statement")</span>
                <span class="text-muted small">Newest 20</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="small">Date</th>
                                <th class="small">Account</th>
                                <th class="small">Product</th>
                                <th class="small">Source</th>
                                <th class="small">Recipient</th>
                                <th class="small">Type</th>
                                <th class="text-end small">Gross</th>
                                <th class="text-end small">Net</th>
                                <th class="text-end small">Paid</th>
                                <th class="text-end small">Outstanding</th>
                                <th class="text-end small">Commission</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.DetailRows.Any())
                            {
                                @foreach (var row in Model.DetailRows)
                                {
                                    <tr>
                                        <td class="small text-muted">@row.SaleDate.ToString("MMM d, yyyy")</td>
                                        <td class="small">@row.BusinessAccountName</td>
                                        <td class="small">@row.ProductName</td>
                                        <td class="small">@row.SourceSystem</td>
                                        <td class="small">@row.BeneficiaryName</td>
                                        <td class="small">@row.DealType</td>
                                        <td class="text-end small">@row.GrossAmount.ToString("C")</td>
                                        <td class="text-end small">@row.NetAmount.ToString("C")</td>
                                        <td class="text-end small">@row.PaidAmount.ToString("C")</td>
                                        <td class="text-end small">@row.OutstandingAmount.ToString("C")</td>
                                        <td class="text-end fw-semibold small text-success">@row.CommissionAmount.ToString("C")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="11" class="text-center text-muted py-5 small">No commission data available yet.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@if (Model.IsAdminView && (Model.RecentImportBatches.Any() || Model.OutstandingBeneficiaryBalances.Any()))
{
    <div class="row g-4 mt-1">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header bg-transparent fw-semibold py-3">Recent Import Batches</div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="small">Batch</th>
                                    <th class="small">Source</th>
                                    <th class="small">Status</th>
                                    <th class="small text-end">Rows</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var batch in Model.RecentImportBatches)
                                {
                                    <tr>
                                        <td class="small">
                                            <a asp-controller="CommissionAdmin" asp-action="ReviewBatch" asp-route-id="@batch.Id" class="text-decoration-none">#@batch.Id</a>
                                        </td>
                                        <td class="small">@batch.SourceSystem</td>
                                        <td class="small">@batch.Status</td>
                                        <td class="text-end small">@batch.RowCount</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card">
                <div class="card-header bg-transparent fw-semibold py-3">Largest Outstanding Balances</div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="small">Recipient</th>
                                    <th class="text-end small">Outstanding</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.OutstandingBeneficiaryBalances.Any())
                                {
                                    @foreach (var balance in Model.OutstandingBeneficiaryBalances)
                                    {
                                        <tr>
                                            <td class="small">@balance.BeneficiaryName</td>
                                            <td class="text-end fw-semibold small">@balance.OutstandingBalance.ToString("C")</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="2" class="text-center text-muted py-4 small">No outstanding balances.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
