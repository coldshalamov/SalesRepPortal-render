@model LeadManagementPortal.Models.ViewModels.CommissionDashboardViewModel

@{
    ViewData["Title"] = "Commission Dashboard";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">Commissions</h1>
    <div class="btn-toolbar gap-2">
        @if (User.IsInRole("OrganizationAdmin") || User.IsInRole("GroupAdmin") || User.IsInRole("SalesOrgAdmin"))
        {
            <a asp-action="Hierarchy" class="btn btn-primary">
                <i class="bi bi-diagram-2"></i> Open Hierarchy
            </a>
        }
        <a asp-action="Details" class="btn btn-outline-primary">
            <i class="bi bi-table"></i> View All Ledger Rows
        </a>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card text-white bg-success mb-3">
            <div class="card-header">Total Earned</div>
            <div class="card-body">
                <h2 class="card-title">@Model.TotalCommissionEarned.ToString("C")</h2>
                <p class="card-text mb-0">@Model.TotalLedgerRows ledger rows</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-dark bg-light mb-3">
            <div class="card-header">This Month</div>
            <div class="card-body">
                <h2 class="card-title">@Model.CurrentMonthCommission.ToString("C")</h2>
                <p class="card-text mb-0">Freshly queried from the commission ledger.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-dark bg-info-subtle mb-3">
            <div class="card-header">Deal Types</div>
            <div class="card-body">
                <h2 class="card-title">@Model.BreakdownByDealType.Count</h2>
                <p class="card-text mb-0">Distinct deal types represented in visible rows.</p>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header">
                Earnings By Deal Type
            </div>
            <div class="card-body">
                @if (Model.BreakdownByDealType.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Deal Type</th>
                                    <th class="text-end">Rows</th>
                                    <th class="text-end">Earned</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in Model.BreakdownByDealType)
                                {
                                    <tr>
                                        <td>@row.DealType</td>
                                        <td class="text-end">@row.RowCount</td>
                                        <td class="text-end fw-semibold">@row.TotalCommission.ToString("C")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0">No commission rows are visible yet.</p>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Recent Ledger Rows</span>
                <span class="text-muted small">Newest 20 visible rows</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Product</th>
                                <th>Beneficiary</th>
                                <th>Deal Type</th>
                                <th class="text-end">Gross</th>
                                <th class="text-end">Net</th>
                                <th class="text-end">Commission</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.DetailRows.Any())
                            {
                                @foreach (var row in Model.DetailRows)
                                {
                                    <tr>
                                        <td>@row.SaleDate.ToString("MMM dd, yyyy")</td>
                                        <td>@row.ProductName</td>
                                        <td>@row.BeneficiaryName</td>
                                        <td>@row.DealType</td>
                                        <td class="text-end">@row.GrossAmount.ToString("C")</td>
                                        <td class="text-end">@row.NetAmount.ToString("C")</td>
                                        <td class="text-end fw-semibold text-success">@row.CommissionAmount.ToString("C")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-4">No commission data is available yet.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
