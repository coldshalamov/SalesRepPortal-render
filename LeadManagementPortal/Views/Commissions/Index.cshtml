@model LeadManagementPortal.Models.ViewModels.CommissionDashboardViewModel

@{
    ViewData["Title"] = "Commission Dashboard";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">Commissions</h1>
    <div class="btn-toolbar">
        @if (Model.IsAdminView)
        {
            <a asp-controller="CommissionAdmin" asp-action="Imports" class="btn btn-primary me-2">
                <i class="bi bi-sliders me-1"></i>Open Control Plane
            </a>
        }
        <a asp-action="Details" class="btn btn-outline-primary">
            <i class="bi bi-table"></i> View All Ledger Rows
        </a>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card text-white bg-success mb-3">
            <div class="card-header">Total Earned</div>
            <div class="card-body">
                <h2 class="card-title">@Model.TotalCommissionEarned.ToString("C")</h2>
                <p class="card-text mb-0">@Model.TotalLedgerRows ledger rows</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-dark bg-light mb-3">
            <div class="card-header">This Month</div>
            <div class="card-body">
                <h2 class="card-title">@Model.CurrentMonthCommission.ToString("C")</h2>
                <p class="card-text mb-0">Current-month earned commissions.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-dark bg-info-subtle mb-3">
            <div class="card-header">Outstanding</div>
            <div class="card-body">
                <h2 class="card-title">@Model.OutstandingBalance.ToString("C")</h2>
                <p class="card-text mb-0">Earned plus adjustments minus payouts.</p>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card text-dark bg-warning-subtle mb-3">
            <div class="card-header">Adjustments</div>
            <div class="card-body">
                <h4 class="card-title">@Model.TotalAdjustments.ToString("C")</h4>
                <p class="card-text mb-0">Net manual corrections applied.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-dark bg-secondary-subtle mb-3">
            <div class="card-header">Paid</div>
            <div class="card-body">
                <h4 class="card-title">@Model.TotalPaid.ToString("C")</h4>
                <p class="card-text mb-0">Amount already included in payout batches.</p>
            </div>
        </div>
    </div>
    @if (Model.IsAdminView)
    {
        <div class="col-md-4">
            <div class="card text-dark bg-light mb-3">
                <div class="card-header">Review Queue</div>
                <div class="card-body">
                    <h4 class="card-title">@Model.PendingReviewRows pending / @Model.ReadyToPostRows ready</h4>
                    <p class="card-text mb-0">@Model.BusinessAccountCount accounts, @Model.ActiveAgreementCount active agreements.</p>
                </div>
            </div>
        </div>
    }
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header">
                Earnings By Calculation Type
            </div>
            <div class="card-body">
                @if (Model.BreakdownByDealType.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Deal Type</th>
                                    <th class="text-end">Rows</th>
                                    <th class="text-end">Earned</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in Model.BreakdownByDealType)
                                {
                                    <tr>
                                        <td>@row.DealType</td>
                                        <td class="text-end">@row.RowCount</td>
                                        <td class="text-end fw-semibold">@row.TotalCommission.ToString("C")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0">No commission rows are visible yet.</p>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>@(Model.IsAdminView ? "Recent Ledger Rows" : "My Recent Statement Rows")</span>
                <span class="text-muted small">Newest 20 visible rows</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Account</th>
                                <th>Product</th>
                                <th>Beneficiary</th>
                                <th>Deal Type</th>
                                <th class="text-end">Gross</th>
                                <th class="text-end">Net</th>
                                <th class="text-end">Paid</th>
                                <th class="text-end">Outstanding</th>
                                <th class="text-end">Commission</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.DetailRows.Any())
                            {
                                @foreach (var row in Model.DetailRows)
                                {
                                    <tr>
                                        <td>@row.SaleDate.ToString("MMM dd, yyyy")</td>
                                        <td>@row.BusinessAccountName</td>
                                        <td>@row.ProductName</td>
                                        <td>@row.BeneficiaryName</td>
                                        <td>@row.DealType</td>
                                        <td class="text-end">@row.GrossAmount.ToString("C")</td>
                                        <td class="text-end">@row.NetAmount.ToString("C")</td>
                                        <td class="text-end">@row.PaidAmount.ToString("C")</td>
                                        <td class="text-end">@row.OutstandingAmount.ToString("C")</td>
                                        <td class="text-end fw-semibold text-success">@row.CommissionAmount.ToString("C")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="9" class="text-center text-muted py-4">No commission data is available yet.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@if (Model.IsAdminView && (Model.RecentImportBatches.Any() || Model.OutstandingBeneficiaryBalances.Any()))
{
    <div class="row g-4 mt-1">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header">Recent Import Batches</div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Batch</th>
                                    <th>Source</th>
                                    <th>Status</th>
                                    <th>Rows</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var batch in Model.RecentImportBatches)
                                {
                                    <tr>
                                        <td>
                                            <a asp-controller="CommissionAdmin" asp-action="ReviewBatch" asp-route-id="@batch.Id">#@batch.Id</a>
                                        </td>
                                        <td>@batch.SourceSystem</td>
                                        <td>@batch.Status</td>
                                        <td>@batch.RowCount</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card">
                <div class="card-header">Largest Outstanding Balances</div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Beneficiary</th>
                                    <th class="text-end">Outstanding</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.OutstandingBeneficiaryBalances.Any())
                                {
                                    @foreach (var balance in Model.OutstandingBeneficiaryBalances)
                                    {
                                        <tr>
                                            <td>@balance.BeneficiaryName</td>
                                            <td class="text-end">@balance.OutstandingBalance.ToString("C")</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="2" class="text-center text-muted py-3">No outstanding balances.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
