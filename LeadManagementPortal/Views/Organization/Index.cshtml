@model LeadManagementPortal.Models.ViewModels.OrganizationViewModel

@{
    ViewData["Title"] = "Hierarchy";
    var totalOrgs    = Model.Groups.Sum(g => g.Orgs.Count);
    var totalMembers = Model.Groups.Sum(g => g.MemberCount);
}

<link rel="stylesheet" href="~/css/org-chart.css" asp-append-version="true" />

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 pt-3 pb-2 mb-4 border-bottom">
    <div>
        <h1 class="h2 mb-1">Hierarchy</h1>
        @if (Model.Groups.Any())
        {
            <p class="text-muted mb-0 small">
                @Model.Groups.Count group@(Model.Groups.Count == 1 ? "" : "s")
                &middot; @totalOrgs org@(totalOrgs == 1 ? "" : "s")
                &middot; @totalMembers member@(totalMembers == 1 ? "" : "s")
            </p>
        }
        else
        {
            <p class="text-muted mb-0 small">Sales team structure — groups, orgs, and members.</p>
        }
    </div>
    <div class="d-flex gap-2 flex-wrap">
        @if (User.IsInRole("OrganizationAdmin") || User.IsInRole("GroupAdmin") || User.IsInRole("SalesOrgAdmin"))
        {
            <a asp-controller="Commissions" asp-action="Hierarchy" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-diagram-2 me-1"></i>Commission Account Map
            </a>
        }
        @if (Model.CanManageGroups)
        {
            <button class="btn btn-primary btn-sm" id="btnAddGroup">
                <i class="bi bi-plus-circle me-1"></i>Add Group
            </button>
        }
    </div>
</div>

@if (Model.Groups.Any())
{
    <div class="hier-chart" id="hierChart">
        @foreach (var group in Model.Groups)
        {
            <div class="hier-group-col" data-group-id="@group.Id">
                <div class="hier-group-card">

                    <div class="hier-group-header">
                        @if (!string.IsNullOrWhiteSpace(group.LogoUrl))
                        {
                            <img src="@group.LogoUrl" alt="@group.Name" class="hier-group-logo" />
                        }
                        else
                        {
                            <div class="hier-group-icon"><i class="bi bi-diagram-3"></i></div>
                        }
                        <div class="hier-group-meta">
                            <span class="hier-group-name">@group.Name</span>
                            <span class="hier-group-stat">
                                @group.Orgs.Count org@(group.Orgs.Count == 1 ? "" : "s")
                                &middot; @group.MemberCount member@(group.MemberCount == 1 ? "" : "s")
                            </span>
                        </div>
                        @if (Model.CanManageGroups)
                        {
                            <div class="hier-actions">
                                <button class="hier-btn"
                                        data-action="edit-group"
                                        data-id="@group.Id"
                                        data-name="@group.Name"
                                        data-description="@(group.Description ?? "")"
                                        title="Edit group">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="hier-btn hier-btn-danger"
                                        data-action="delete-group"
                                        data-id="@group.Id"
                                        data-name="@group.Name"
                                        title="Delete group">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(group.Description))
                    {
                        <p class="hier-group-desc">@group.Description</p>
                    }

                    <div class="hier-orgs" id="orgList_@group.Id">
                        @foreach (var org in group.Orgs)
                        {
                            <div class="hier-org-card" data-org-id="@org.Id">
                                @if (!string.IsNullOrWhiteSpace(org.LogoUrl))
                                {
                                    <img src="@org.LogoUrl" alt="@org.Name" class="hier-org-logo" />
                                }
                                else
                                {
                                    <div class="hier-org-icon"><i class="bi bi-people"></i></div>
                                }
                                <div class="hier-org-meta">
                                    <span class="hier-org-name">@org.Name</span>
                                    <span class="hier-org-stat">@org.MemberCount member@(org.MemberCount == 1 ? "" : "s")</span>
                                </div>
                                @if (Model.CanManageOrgs)
                                {
                                    <div class="hier-actions">
                                        <button class="hier-btn"
                                                data-action="edit-org"
                                                data-id="@org.Id"
                                                data-name="@org.Name"
                                                data-group-id="@group.Id"
                                                title="Edit org">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="hier-btn hier-btn-danger"
                                                data-action="delete-org"
                                                data-id="@org.Id"
                                                data-name="@org.Name"
                                                title="Delete org">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                        @if (Model.CanManageOrgs)
                        {
                            <button class="hier-add-org-btn" data-action="add-org" data-group-id="@group.Id">
                                <i class="bi bi-plus"></i> Add Org
                            </button>
                        }
                    </div>

                </div>
            </div>
        }
    </div>
}
else
{
    <div class="hier-empty">
        <i class="bi bi-diagram-3 hier-empty-icon"></i>
        <p class="fw-medium text-secondary mb-1">No groups yet</p>
        <p class="text-muted small mb-3">Create your first group to start building the team structure.</p>
        @if (Model.CanManageGroups)
        {
            <button class="btn btn-primary btn-sm" id="btnAddGroupEmpty">
                <i class="bi bi-plus-circle me-1"></i>Create First Group
            </button>
        }
    </div>
}

@Html.AntiForgeryToken()

@* ── Group modal ─────────────────────────────────────────────────────────── *@
<div class="modal fade" id="groupModal" tabindex="-1" aria-labelledby="groupModalTitle" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="groupModalTitle">Add Group</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="groupModalId" />
                <div class="mb-3">
                    <label class="form-label" for="groupModalName">Group Name <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="groupModalName" maxlength="200" autocomplete="off" />
                </div>
                <div class="mb-0">
                    <label class="form-label" for="groupModalDescription">Description</label>
                    <textarea class="form-control" id="groupModalDescription" rows="3" maxlength="500"></textarea>
                </div>
                <div id="groupModalError" class="alert alert-danger mt-3 mb-0 d-none"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="groupModalSave">
                    <span class="spinner-border spinner-border-sm d-none me-1" id="groupModalSpinner" role="status"></span>
                    Save
                </button>
            </div>
        </div>
    </div>
</div>

@* ── Org modal ───────────────────────────────────────────────────────────── *@
<div class="modal fade" id="orgModal" tabindex="-1" aria-labelledby="orgModalTitle" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="orgModalTitle">Add Org</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="orgModalId" />
                <input type="hidden" id="orgModalGroupId" />
                <div class="mb-0">
                    <label class="form-label" for="orgModalName">Org Name <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="orgModalName" maxlength="200" autocomplete="off" />
                </div>
                <div id="orgModalError" class="alert alert-danger mt-3 mb-0 d-none"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="orgModalSave">
                    <span class="spinner-border spinner-border-sm d-none me-1" id="orgModalSpinner" role="status"></span>
                    Save
                </button>
            </div>
        </div>
    </div>
</div>

@* ── Delete confirm modal ─────────────────────────────────────────────────── *@
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title text-danger" id="deleteModalLabel">
                    <i class="bi bi-exclamation-triangle me-1"></i>Delete
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-2">
                <p id="deleteModalMessage" class="mb-0 small"></p>
                <div id="deleteModalError" class="alert alert-danger mt-3 mb-0 d-none"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger btn-sm" id="deleteModalConfirm">
                    <span class="spinner-border spinner-border-sm d-none me-1" id="deleteModalSpinner" role="status"></span>
                    Delete
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/org-chart.js" asp-append-version="true"></script>
}
